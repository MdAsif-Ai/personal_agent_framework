# OpenAI API Key (required for LLM & evaluator)
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model (default: gpt-5.4-mini or gpt-4o-mini)
OPENAI_MODEL=gpt-5.4-mini

# Google Serper API Key (optional: used by web search tool)
# Get a key at https://serper.dev
SERPER_API_KEY=your_serper_api_key_here

# Pushover API credentials (optional: used for real phone push notifications)
# If omitted, notifications will be safely simulated in logs.
PUSHOVER_TOKEN=your_pushover_app_token_here
PUSHOVER_USER=your_pushover_user_key_here

# Execution limits
MAX_EVALUATION_ATTEMPTS=3
MODEL_CALL_LIMIT=30

